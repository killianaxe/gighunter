# Server port
PORT=3000

# SQLite database file (relative to server/ or absolute path)
DATABASE_PATH=./data/orbit.db

# Default user id for Phase 1 (no auth yet)
DEFAULT_USER_ID=default-user

# Adzuna (https://developer.adzuna.com/) — register for a free app_id/app_key
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# USAJOBS (https://developer.usajobs.gov/) — register with your email for a key
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# Telegram notifier (optional) — create a bot via @BotFather for the token.
# For the chat id: message your bot once, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and read result[].message.chat.id
# A bot cannot message you until you have sent it at least one message.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Anthropic API key (https://console.anthropic.com/settings/keys)
# Required for LLM features: resume tailoring, bullet mining, application drafts.
ANTHROPIC_API_KEY=
