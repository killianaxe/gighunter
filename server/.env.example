# Server port
PORT=3000

# SQLite database file (relative to server/ or absolute path)
DATABASE_PATH=./data/orbit.db

# Default user id for Phase 1 (no auth yet)
DEFAULT_USER_ID=default-user

# Adzuna (https://developer.adzuna.com/) — register for a free app_id/app_key
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# USAJOBS (https://developer.usajobs.gov/) — register with your email for a key
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# Telegram notifier (optional) — create a bot via @BotFather for the token.
# For the chat id: message your bot once, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and read result[].message.chat.id
# A bot cannot message you until you have sent it at least one message.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Anthropic API key (https://console.anthropic.com/settings/keys)
# Required for LLM features: resume tailoring, bullet mining, application drafts.
ANTHROPIC_API_KEY=

# Jooble (https://jooble.org/api/about) — free key, requested by email.
# The only Phase 2 board with real server-side search; the others are filtered locally.
JOOBLE_API_KEY=
# Optional location bias for Jooble ("remote", "Kansas City, MO", …). Blank searches everywhere.
JOOBLE_LOCATION=

# The Muse (https://www.themuse.com/developers/api/v2) — works without a key, but an
# unauthenticated caller is limited to roughly 500 requests/hour.
MUSE_API_KEY=
# The Muse has no free-text search, only categories. Unfiltered it is 408k listings across
# 20,440 pages; these two narrow it to a workable few thousand before local filtering.
MUSE_CATEGORIES=Computer and IT,IT

# Base URL used to build the resume links in Telegram digest messages.
#
# Defaults to http://127.0.0.1:3000 — correct for reading the digest at this machine, and
# useless on a phone, where 127.0.0.1 is the phone itself. Point this at a host your phone can
# actually reach (a Tailscale name, a LAN address, a tunnel) and the links resolve there too.
# Regardless of this setting, the .docx pushed into the chat by the auto-scheduler remains the
# copy that works anywhere.
GIGHUNTER_PUBLIC_BASE_URL=
