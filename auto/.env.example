# Base URL where Orbit's Fastify server is reachable
ORBIT_BASE_URL=http://127.0.0.1:3000

# Auto-start Orbit (via `npm run dev`) if it isn't already running when a tool/cycle needs it
AUTO_START_ORBIT=true

# gighunter project root to run `npm run dev` in when auto-starting Orbit.
# Defaults to the parent directory of this project (auto/ is a workspace nested inside gighunter/),
# so you normally don't need to set this.
ORBIT_PROJECT_DIR=

# How often (minutes) the auto-draft scheduler checks for new strong matches
AUTO_DRAFT_INTERVAL_MINUTES=15

# Minimum match score (0-100) that triggers an auto-draft
AUTO_DRAFT_THRESHOLD=70

# Where auto-drafted .docx resumes are saved (relative to this project, or an absolute path)
RESUME_DOWNLOAD_DIR=./downloads
